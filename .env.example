# ==========================================
# SAM BRAND STORE - ENVIRONMENT CONFIGURATION
# ==========================================

# Server execution environment (production | development)
NODE_ENV="production"

# Server listening port (Hostinger typically assigns dynamically via process.env.PORT or port 3000)
PORT="3000"

# Public URL where the store is hosted (e.g. https://sambrandstore.com)
APP_URL="https://your-domain.com"

# Admin credentials (set in production environment)
ADMIN_EMAIL="your-admin@example.com"
ADMIN_PASSWORD="your-secure-password"

SESSION_SECRET="replace-with-a-secure-random-secret-at-least-32-chars"

# SQLite database file path (resolves relative to process.cwd())
DB_PATH="./data/sam_brand_store.db"

# Store WhatsApp contact number for customer orders and inquiry redirects (international format without +)
STORE_WHATSAPP_NUMBER="96171972495"

# Optional: Google Gemini API key for AI assistant features
GEMINI_API_KEY=""
